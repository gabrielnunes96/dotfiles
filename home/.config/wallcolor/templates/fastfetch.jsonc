{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;{{accent_dark_rgb}}", "2": "38;2;70;70;76", "3": "38;2;{{accent_rgb}}" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;{{accent_dark_rgb}}", "title": "38;2;{{accent_rgb}}" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;106;106;112mlil gab" },
    "break",
    { "type": "os",       "key": "os    ", "format": "{name} {version}" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm    " },
    { "type": "shell",    "key": "shell " },
    { "type": "terminal", "key": "term  " },
    { "type": "cpu",      "key": "cpu   ", "format": "{name}" },
    { "type": "gpu",      "key": "gpu   ", "format": "AMD Radeon RX 9060 XT" },
    { "type": "memory",   "key": "mem   " },
    { "type": "disk",     "key": "disk  ", "folders": "/:/dados" },
    { "type": "uptime",   "key": "uptime" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
