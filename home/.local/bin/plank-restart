#!/usr/bin/env bash
# Restarts Plank through its systemd user service, which also brings it back
# if it crashes. A single plank process draws both docks (enabled-docks =
# dock1 on DisplayPort-1, dock2 on HDMI-A-0).
# Plank computes its position when it starts; after monitor changes (login,
# fullscreen games switching resolution) it can end up stuck in a corner.
pkill -x plank   # any copy started outside the service
systemctl --user restart plank.service
